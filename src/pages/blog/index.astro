---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="部落格 | Raccoon Notes">
  <div class="max-w-3xl mx-auto">
    <header class="mb-12">
      <h1 class="text-4xl font-bold mb-4 font-['Outfit']">部落格</h1>
      <p class="text-slate-600 dark:text-slate-400">分享技術心得、讀書筆記與開發日誌。</p>
    </header>

    <div class="space-y-12">
      {posts.map(post => (
        <article class="flex flex-col md:flex-row gap-6 group">
          <time class="md:w-32 flex-shrink-0 text-sm text-slate-400 pt-1">
            {post.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'short', day: 'numeric' })}
          </time>
          <div>
            <h2 class="text-2xl font-bold mb-2 group-hover:text-[var(--accent)] transition-colors">
              <a href={`/blog/${post.id}`}>{post.data.title}</a>
            </h2>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed mb-4">
              {post.data.description}
            </p>
            <div class="flex gap-2">
              {post.data.tags.map(tag => (
                <span class="text-xs text-slate-500 bg-slate-100 dark:bg-slate-800 px-2 py-1 rounded">#{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
