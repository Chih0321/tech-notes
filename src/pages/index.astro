---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const recentNotes = (await getCollection("notes"))
  .sort(
    (a, b) =>
      (b.data.lastUpdated?.valueOf() || 0) -
      (a.data.lastUpdated?.valueOf() || 0),
  )
  .slice(0, 4);
---

<BaseLayout title="Raccoon Notes | Home">
  <section class="py-12 md:py-20 text-center">
    <h1
      class="text-5xl md:text-7xl font-extrabold mb-6 tracking-tight font-['Outfit'] bg-gradient-to-r from-blue-600 to-indigo-500 bg-clip-text text-transparent"
    >
      致力於實用與活化的筆記
    </h1>
    <p
      class="text-xl md:text-2xl text-slate-600 dark:text-slate-300 max-w-2xl mx-auto leading-relaxed"
    >
      紀錄結構工程知識。
    </p>
    <div class="mt-10 flex justify-center gap-4">
      <a
        href="/notes"
        class="px-8 py-3 bg-[var(--accent)] text-white rounded-lg font-semibold hover:bg-[var(--accent-hover)] transition-all transform hover:scale-105 shadow-lg shadow-blue-500/20"
      >
        瀏覽筆記
      </a>
      <a
        href="/blog"
        class="px-8 py-3 bg-[var(--card-bg)] text-[var(--text-primary)] border border-[var(--border-color)] rounded-lg font-semibold hover:border-[var(--accent)] transition-all"
      >
        閱讀部落格
      </a>
    </div>
  </section>

  <div class="grid md:grid-cols-2 gap-12 mt-16">
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold font-['Outfit'] text-[var(--text-heading)]">最新文章</h2>
        <a
          href="/blog"
          class="text-sm font-medium text-[var(--accent)] hover:underline"
          >全部文章 &rarr;</a
        >
      </div>
      <div class="space-y-4">
        {
          latestPosts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="block group p-5 rounded-2xl bg-[var(--card-bg)] border border-[var(--border-color)] hover:border-[var(--accent)] hover:shadow-lg hover:shadow-blue-500/10 hover:-translate-y-0.5 transition-all duration-200"
            >
              <time class="text-xs text-slate-400 dark:text-slate-500 block mb-2 font-mono">
                {post.data.pubDate.toLocaleDateString("zh-TW")}
              </time>
              <h3 class="text-base font-semibold text-[var(--text-heading)] group-hover:text-[var(--accent)] transition-colors mb-1.5">
                {post.data.title}
              </h3>
              <p class="text-sm text-[var(--text-primary)] opacity-70 line-clamp-2 leading-relaxed">
                {post.data.description}
              </p>
            </a>
          ))
        }
      </div>
    </section>

    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold font-['Outfit'] text-[var(--text-heading)]">近期筆記</h2>
        <a
          href="/notes"
          class="text-sm font-medium text-[var(--accent)] hover:underline"
          >瀏覽技術文庫 &rarr;</a
        >
      </div>
      <div class="grid gap-4">
        {
          recentNotes.map((note) => (
            <a
              href={`/notes/${note.id}`}
              class="group p-4 rounded-xl bg-[var(--card-bg)] border border-[var(--border-color)] flex items-center justify-between hover:border-[var(--accent)] hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
            >
              <div>
                <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400 dark:text-slate-500 block mb-0.5">
                  {note.data.category}
                </span>
                <span class="font-semibold text-[var(--text-heading)] group-hover:text-[var(--accent)] transition-colors">{note.data.title}</span>
              </div>
              <svg
                class="w-4 h-4 text-slate-400 dark:text-slate-600 group-hover:text-[var(--accent)] group-hover:translate-x-0.5 transition-all flex-shrink-0"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                />
              </svg>
            </a>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
