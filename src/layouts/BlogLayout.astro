---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";
import BlogSidebar from "../components/BlogSidebar.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    pubDate: Date;
    tags?: string[];
  };
  headings: { depth: number; slug: string; text: string }[];
  currentSlug?: string;
}

const { frontmatter, headings, currentSlug } = Astro.props;
const formattedDate = new Date(frontmatter.pubDate).toLocaleDateString(
  "zh-TW",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <div
    class="flex flex-col lg:flex-row w-full max-w-screen-2xl mx-auto px-2 md:px-6"
  >
    <!-- Left Sidebar -->
    <div
      class="lg:w-64 flex-shrink-0 lg:pt-8 lg:pb-12 lg:sticky lg:top-16 lg:h-[calc(100vh-4rem)] lg:overflow-y-auto"
    >
      <BlogSidebar currentSlug={currentSlug} />
    </div>

    <!-- Center Content -->
    <article class="flex-grow min-w-0 py-8 lg:px-12 max-w-4xl mx-auto">
      <header class="mb-8 pb-8 border-b border-[var(--border-color)]">
        <h1 class="text-4xl font-extrabold mb-4 font-['Outfit']">
          {frontmatter.title}
        </h1>
        <div
          class="flex items-center text-sm text-gray-500 dark:text-gray-400 space-x-4"
        >
          <time datetime={frontmatter.pubDate.toISOString()}
            >{formattedDate}</time
          >
          {
            frontmatter.tags && frontmatter.tags.length > 0 && (
              <div class="flex space-x-2">
                {frontmatter.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                    #{tag}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <div class="prose-custom">
        <slot />
      </div>
    </article>

    <!-- Right ToC -->
    <aside
      class="hidden xl:block w-56 flex-shrink-0 pt-8 pb-12 sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto pr-2"
    >
      <TableOfContents headings={headings} />
    </aside>
  </div>
</BaseLayout>
