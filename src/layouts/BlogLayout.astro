---
import BaseLayout from "./BaseLayout.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
    pubDate: Date;
    tags?: string[];
  };
  headings: { depth: number; slug: string; text: string }[];
}

const { frontmatter, headings } = Astro.props;
const formattedDate = new Date(frontmatter.pubDate).toLocaleDateString(
  "zh-TW",
  {
    year: "numeric",
    month: "long",
    day: "numeric",
  },
);
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="grid grid-cols-1 lg:grid-cols-[1fr_200px] gap-12">
    <div>
      <header class="mb-8 pb-8 border-b border-[var(--border-color)]">
        <h1 class="text-4xl font-extrabold mb-4 font-['Outfit']">
          {frontmatter.title}
        </h1>
        <div
          class="flex items-center text-sm text-gray-500 dark:text-gray-400 space-x-4"
        >
          <time datetime={frontmatter.pubDate.toISOString()}
            >{formattedDate}</time
          >
          {
            frontmatter.tags && frontmatter.tags.length > 0 && (
              <div class="flex space-x-2">
                {frontmatter.tags.map((tag) => (
                  <span class="px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                    #{tag}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <div class="prose-custom">
        <slot />
      </div>
    </div>

    <aside class="hidden lg:block">
      <div class="sticky top-24">
        <TableOfContents headings={headings} />
      </div>
    </aside>
  </article>
</BaseLayout>
