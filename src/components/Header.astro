---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  { label: "首頁", href: "/" },
  { label: "筆記", href: "/notes" },
  { label: "部落格", href: "/blog" },
  { label: "關於", href: "/about" },
];
---

<header
  class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/70 dark:bg-[var(--bg-primary)]/70 border-b border-[var(--border-color)]"
>
  <div
    class="container mx-auto px-4 h-16 flex items-center justify-between max-w-7xl"
  >
    <a
      href="/"
      class="flex items-center gap-3 group transition-opacity hover:opacity-80"
    >
      <div class="w-9 h-9 overflow-hidden">
        <img
          src="/icon.png"
          alt="Raccoon Notes Logo"
          class="w-full h-full object-contain"
        />
      </div>
      <span
        class="text-2xl font-bold bg-gradient-to-br from-[var(--text-heading)] to-[var(--accent)] bg-clip-text text-transparent"
      >
        Raccoon Notes
      </span>
    </a>
    <div class="flex items-center gap-4">
      <nav>
        <ul class="flex items-center gap-6">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="px-2 py-1.5 rounded-md text-sm font-semibold hover:text-[var(--accent)] hover:bg-[var(--accent)] hover:bg-opacity-10 transition-all duration-200 text-[var(--text-heading)]"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="h-6 w-px bg-gray-200 dark:bg-gray-700 mx-2"></div>
      <ThemeToggle />
    </div>
  </div>
</header>
