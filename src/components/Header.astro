---
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { label: '首頁', href: '/' },
  { label: '筆記', href: '/notes' },
  { label: '部落格', href: '/blog' },
  { label: '關於', href: '/about' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/70 dark:bg-black/70 border-b border-[var(--border-color)]">
  <div class="container mx-auto px-4 h-16 flex items-center justify-between max-w-7xl">
    <a href="/" class="text-2xl font-bold bg-gradient-to-r from-blue-600 to-cyan-500 bg-clip-text text-transparent font-['Outfit']">
      Raccoon Notes
    </a>
    <div class="flex items-center space-x-6">
      <nav>
        <ul class="flex space-x-6">
          {navItems.map(item => (
            <li>
              <a href={item.href} class="text-sm font-medium hover:text-[var(--accent)] transition-colors text-[var(--text-primary)]">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="h-6 w-px bg-gray-200 dark:bg-gray-700 mx-2"></div>
      <ThemeToggle />
    </div>
  </div>
</header>
