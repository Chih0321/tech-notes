---
const today = new Date();
---

<footer class="border-t border-[var(--border-color)] py-8 mt-12 bg-[var(--sidebar-bg)]">
  <div class="container mx-auto px-4 max-w-5xl text-center">
    <p class="text-sm text-gray-500 dark:text-gray-400">
      &copy; {today.getFullYear()} Raccoon. Built with Astro & Tailwind.
    </p>
  </div>
</footer>
