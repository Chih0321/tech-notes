---
const today = new Date();
---

<footer
  class="border-t border-[var(--border-color)] py-8 mt-12 bg-[var(--sidebar-bg)]"
>
  <div class="container mx-auto px-4 max-w-7xl text-center">
    <p class="text-sm text-[var(--text-primary)] opacity-50">
      &copy; {today.getFullYear()} Raccoon. Built with Astro &amp; Tailwind.
    </p>
  </div>
</footer>
