---
import { getCollection } from "astro:content";

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
const allNotes = await getCollection("notes");

// Group notes by category
const categories = allNotes.reduce(
  (acc, note) => {
    const category = note.data.category || "Other";
    if (!acc[category]) acc[category] = [];
    acc[category].push(note);
    return acc;
  },
  {} as Record<string, typeof allNotes>,
);

// Sort categories and notes within categories
const sortedCategories = Object.keys(categories).sort();
sortedCategories.forEach((cat) => {
  categories[cat].sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
});
---

<nav class="w-full flex-shrink-0 h-fit pr-4">
  <div class="space-y-8">
    {
      sortedCategories.map((category) => (
        <div>
          <h2 class="text-xs font-bold text-[var(--accent)]/50 uppercase tracking-widest mb-4 px-2">
            {category}
          </h2>
          <ul class="flex flex-col gap-1">
            {categories[category].map((note) => (
              <li>
                <a
                  href={`/notes/${note.id}`}
                  class={`block px-3 py-2 text-sm rounded-lg transition-all ${
                    currentSlug === note.id
                      ? "bg-[var(--accent)]/10 text-[var(--accent)] font-bold border-l-4 border-[var(--accent)]"
                      : "text-[var(--text-primary)] opacity-70 hover:opacity-100 hover:bg-[var(--accent)]/5"
                  }`}
                >
                  {note.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</nav>
