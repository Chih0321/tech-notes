---
import { getCollection } from "astro:content";

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;

// Fetch all posts
const allPosts = await getCollection("blog");

// Get 5 most recent posts
const recentPosts = [...allPosts]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

// Extract all unique tags
const allTags = [
  ...new Set(allPosts.flatMap((post) => post.data.tags || [])),
].sort();
---

<nav class="w-full flex-shrink-0 h-fit pr-4">
  <div class="space-y-10">
    <div>
      <h2
        class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4 px-2"
      >
        最新文章
      </h2>
      <ul class="space-y-1">
        {
          recentPosts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class={`block px-2 py-2 text-sm rounded-md transition-all ${
                  currentSlug === post.id
                    ? "bg-blue-50 text-blue-700 font-semibold dark:bg-blue-900/30 dark:text-blue-300"
                    : "text-[var(--text-heading)] hover:text-[var(--accent)] hover:bg-gray-100 dark:hover:bg-gray-800"
                }`}
              >
                <div class="line-clamp-2 leading-tight">{post.data.title}</div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      allTags.length > 0 && (
        <div>
          <h2 class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4 px-2">
            文章標籤
          </h2>
          <div class="flex flex-wrap gap-2 px-2">
            {allTags.map((tag) => (
              <span class="px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )
    }
  </div>
</nav>
